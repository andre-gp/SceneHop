.header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 24px;
    padding: 2px 5px 0 5px;
}

.settings-button {
    width: 20px;
    height: 20px;
    padding: 2px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.settings-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.settings-button--on {
    background-color: var(--unity-colors-button-background-pressed);
}

.settings-button--on:hover {
    background-color: var(--unity-colors-button-background-hover_pressed);
}

.settings-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 4px;
    margin-right: 52px;
}

.settings-container {
    flex-wrap: nowrap;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0 5px 2px 5px;
}

.settings-container--hidden {
    display: none;
}

.toolbar-favorites {
    flex-direction: row;
    align-items: center;
    align-self: center;
    flex-shrink: 0;
    margin-left: 4px;
}

.scene-button {
    width: 60px;
    height: 40px;
    font-size: 10px;
    white-space: normal;
    overflow: hidden;
    padding-left: 2px;
    padding-right: 2px;
    margin: 2px;
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.scene-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.scene-button:active {
    background-color: var(--unity-colors-button-background-pressed);
}

.scene-button--current {
    border-color: var(--unity-colors-highlight-background);
    border-width: 1px;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.dropdown {
    width: 150px;
    min-width: 40px;
    flex-shrink: 1;
    align-items: center;
    margin: 0;
}

.separator {
    height: 1px;
    min-height: 1px;
    max-height: 1px;
    background-color: var(--unity-colors-inspector_titlebar-border);
    margin-top: 0;
    margin-bottom: 2px;
}

.text-field {
    width: 150px;
    max-width: 100%;
    flex-shrink: 1;
    margin: 2px 0 2px 24px;
}

.zoom-slider {
    height: 25px;
    width: 50px;
    position: absolute;
    right: 0;
    display: flex;
    top: 2px;
    margin-top: 0;
    min-height: 25px;
    min-width: 50px;
}

.small-button {
    padding: 0 2px;
    margin-top: 5px;
    margin-bottom: 5px;
    margin-right: 2px;
    width: 16px;
    height: 16px;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.favorite-button {
    border-color: rgb(255, 193, 7);
    background-color: rgba(255, 193, 7, 0.15);
}

.favorite-button:hover {
    background-color: rgba(255, 193, 7, 0.25);
}

.favorite-button:active {
    background-color: rgba(255, 193, 7, 0.35);
}

.empty-label {
    white-space: normal;
    max-width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    padding: 8px 4px;
    opacity: 0.75;
    -unity-font-style: italic;
}

.grid--list {
    flex-direction: column;
    flex-wrap: nowrap;
}

.scene-button--list {
    width: auto;
    align-self: stretch;
    height: 20px;
    min-height: 20px;
    font-size: 11px;
    -unity-text-align: middle-left;
    padding-left: 24px;
    margin: 1px 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.scene-button__icon {
    display: none;
    position: absolute;
    left: 4px;
    top: 50%;
    translate: 0 -50%;
    width: 14px;
    height: 14px;
}

.scene-button--list > .scene-button__icon {
    display: flex;
}
